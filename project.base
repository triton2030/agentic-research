filters:
  and:
    - file.ext == "md"
formulas:
  layer: if(file.path == "README.md", "README", if(file.path == "AGENTS.md", "Codex", if(file.path == "CLAUDE.md", "Claude", if(file.path == "_ops/PROJECT-ROADMAP.md", "Roadmap", if(file.path == "_ops/AGENTS.md", "Ops route", if(file.inFolder("_ops/criteria"), "Criteria", if(file.inFolder("_ops/interviews"), "Interviews", if(file.inFolder("_ops/problems"), "Problems", if(file.inFolder("_ops/plans"), "Tasks", if(file.inFolder("knowledge"), "Knowledge", "Other"))))))))))
  cover: if(file.inFolder("_ops/criteria"), "#7cc4ff", if(file.inFolder("_ops/interviews"), "#f3a6cf", if(file.inFolder("_ops/problems"), "#ffcf66", if(file.inFolder("_ops/plans"), "#ff9f80", if(file.inFolder("knowledge"), "#8bd49c", if(file.path == "_ops/PROJECT-ROADMAP.md", "#b8a1ff", "#d0d7de"))))))
  domain: if(file.path == "knowledge/wisdom-llm.md", "Модели", if(file.path == "knowledge/wisdom-gpt-5.5.md", "Модели", if(file.path == "knowledge/wisdom-claude-opus-4.7.md", "Модели", if(file.path == "knowledge/wisdom-claude-code.md", "Поверхности", if(file.path == "knowledge/wisdom-codex.md", "Поверхности", if(file.path == "knowledge/wisdom-agents.md", "Поверхности", if(file.path == "knowledge/wisdom-skills-plugins.md", "Метаподходы", if(file.path == "knowledge/wisdom-structural-critique.md", "Метаподходы", if(file.path == "knowledge/wisdom-systems-thinking.md", "Метаподходы", "Other"))))))))))
  wisdomCover: if(formula.domain == "Модели", "#b8a1ff", if(formula.domain == "Поверхности", "#7cc4ff", if(formula.domain == "Метаподходы", "#8bd49c", "#d0d7de")))
properties:
  formula.layer:
    displayName: Слой
  formula.domain:
    displayName: Домен
  file.name:
    displayName: Файл
  file.folder:
    displayName: Папка
  file.mtime:
    displayName: Изменён
  file.tags:
    displayName: Теги
views:
  - type: kanban-view
    name: Проект
    filters:
      or:
        - file.path == "README.md"
        - file.path == "AGENTS.md"
        - file.path == "CLAUDE.md"
        - file.path == "_ops/PROJECT-ROADMAP.md"
        - file.path == "_ops/AGENTS.md"
    order:
      - file.name
      - formula.layer
      - file.folder
      - file.mtime
    groupByProperty: formula.layer
    imageFit: contain
    imageAspectRatio: 0.5
    wrapPropertyValues: true
    columnOrders:
      formula.layer:
        - README
        - Roadmap
        - Codex
        - Claude
        - Ops route
    cardOrders:
      formula.layer: {}
    columnColors:
      formula.layer:
        README: green
        Roadmap: cyan
        Codex: blue
        Claude: purple
        Ops route: yellow
  - type: table
    name: Операционный слой
    filters:
      and:
        - file.inFolder("_ops")
    order:
      - formula.layer
      - file.name
      - file.folder
      - file.mtime
  - type: cards
    name: Критерии
    filters:
      and:
        - file.inFolder("_ops/criteria")
    order:
      - file.name
      - file.mtime
    image: formula.cover
    imageFit: cover
    cardSize: 160
  - type: table
    name: Интервью
    filters:
      and:
        - file.inFolder("_ops/interviews")
        - not:
            - file.inFolder("_ops/interviews/_archive")
    order:
      - file.name
      - file.folder
      - file.mtime
    columnSize:
      file.name: 360
  - type: table
    name: Проблемы
    filters:
      and:
        - file.inFolder("_ops/problems")
        - not:
            - file.inFolder("_ops/problems/_archive")
    order:
      - file.name
      - file.folder
      - file.mtime
    columnSize:
      file.name: 382
  - type: table
    name: Планы
    filters:
      and:
        - file.inFolder("_ops/plans")
    order:
      - file.name
      - file.folder
      - file.mtime
    columnSize:
      file.name: 300
  - type: kanban-view
    name: Мудрости
    filters:
      and:
        - file.inFolder("knowledge")
        - file.name.startsWith("wisdom-")
        - file.ext == "md"
    order:
      - file.name
      - formula.domain
      - file.mtime
    groupByProperty: formula.domain
    image: formula.wisdomCover
    imageFit: cover
    imageAspectRatio: 0.4
    wrapPropertyValues: true
    columnOrders:
      formula.domain:
        - Модели
        - Поверхности
        - Метаподходы
        - Uncategorized
    cardOrders:
      formula.domain: {}
    columnColors:
      formula.domain:
        Модели: purple
        Поверхности: cyan
        Метаподходы: green
  - type: table
    name: Знания
    filters:
      and:
        - file.inFolder("knowledge")
    order:
      - formula.layer
      - file.name
      - file.folder
      - file.mtime
    sort:
      - property: file.mtime
        direction: ASC
    limit: 80
    columnSize: {}
  - type: table
    name: View
